{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  // Tests run under vitest (root vitest.config.ts) and are not shipped in
  // dist; the root tsconfig excludes **/*.test.ts for the same reason.
  "exclude": ["src/**/*.test.ts"]
}
