{
  // Typecheck-only view of the package that INCLUDES the test files.
  //
  // tsconfig.json excludes `src/**/*.test.ts` because `build` emits to dist/
  // and tests must not ship. But build and typecheck shared one config, so
  // that exclusion also hid tests from the typechecker — and the root config
  // excludes `packages/cli` wholesale, so nothing checked them at all.
  //
  // Splitting the two keeps tests out of dist/ while still failing the build
  // on a type error inside one. Wired as the second half of the package's
  // `typecheck` script.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
