<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- generated by packages/popcorn/deploy/install.sh — re-run the installer
     rather than hand-editing: it reads whatever is already here and keeps it. -->
<!-- template-only: everything from here to the closing marker is stripped
     when the file is rendered, so it never lands in ~/Library/LaunchAgents.

     launchd agent — macOS branch. A TEMPLATE, not a drop-in file: the
     __TOKENS__ below are substituted by deploy/install.sh, which fills them
     from this machine's existing unit first and these defaults second.

       sh deploy/install.sh --render    # print the rendered plist, write nothing
       sh deploy/install.sh --check     # print what installing would change
       sh deploy/install.sh             # install (refuses to degrade an existing unit)

     Do NOT `cp` this file into ~/Library/LaunchAgents by hand. Earlier it was
     a literal file and the installer copied it over whatever was already
     there; on the one machine popcorn actually ran on, that swapped a
     tailnet-only bind for every interface, dropped the SMTP face entirely,
     and pointed TLS at paths that did not exist.

     Defaults, and why:
       binary  $HOME/bin/popcorn — a user agent needs no sudo to install or
               to replace, and launchd runs it as you either way. /usr/local
               buys nothing here except a password prompt.
       POP3    127.0.0.1:9995 — fail closed. Ports <1024 need a LaunchDaemon
               in /Library/LaunchDaemons, and a template must never be the
               reason a mail port faces the internet. Widen deliberately:
               deploy/install-tailscale-macos.sh binds the tailnet address,
               or pass --listen ... --allow-plaintext / with certs.
       SMTP    127.0.0.1:9587 — present on purpose. popcorn's submission face
               exists only while POPCORN_SMTP_LISTEN is set (cmd/popcorn/
               main.go), so a template that omits it is a template that can
               silently delete outgoing mail.
       TLS     $HOME/.popcorn/{cert,key}.pem — where `tailscale cert` writes.
               install.sh drops both keys when the files are absent, because
               a cert path that resolves to nothing makes popcorn exit at
               startup and crash-loop under KeepAlive.
       log     $HOME/.popcorn/popcorn.log — a path that exists. launchd fails
               to spawn the job if it cannot open StandardOutPath, and
               /usr/local/var/log is not present on a stock macOS. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cc.bullmoose.popcorn</string>

    <key>ProgramArguments</key>
    <array>
        <string>__POPCORN_PROGRAM__</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>POPCORN_LISTEN</key><string>__POPCORN_LISTEN__</string>
        <key>POPCORN_SMTP_LISTEN</key><string>__POPCORN_SMTP_LISTEN__</string>
        <key>POPCORN_TLS_CERT</key><string>__POPCORN_TLS_CERT__</string>
        <key>POPCORN_TLS_KEY</key><string>__POPCORN_TLS_KEY__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__POPCORN_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__POPCORN_LOG__</string>
</dict>
</plist>
