{
  // Typecheck-only view that INCLUDES the client unit tests. Split from
  // tsconfig.json so the app view stays test-free (same pattern as
  // packages/cli/tsconfig.test.json). Tests run under the root vitest config;
  // this only proves they type-check. `@bullmoose/jmap-core` resolves through
  // the workspace symlink (declared as a devDependency).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // `@bullmoose/auth-core` is redirected to a local declaration on purpose —
    // see the header of `src/types/auth-core.d.ts`. tsc checks the SHAPE here;
    // vitest imports the REAL module through `resolve.alias` and checks the
    // BEHAVIOUR. Following the real source with tsc instead would drag Worker
    // code into a DOM-typed program, which is what the root tsconfig excludes
    // `webmail` to avoid.
    "paths": {
      "@bullmoose/auth-core": ["./src/types/auth-core.d.ts"]
    }
  },
  "include": ["src/**/*.test.ts", "src/**/*.ts", "src/**/*.tsx", "src/types/*.d.ts"],
  "exclude": ["dist", "node_modules", ".astro"]
}
