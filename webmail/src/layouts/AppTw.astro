---
// The Tailwind app shell (s07 nav spike) — sidebar + header, ported from the
// `full-width-with-narrow-sidebar-and-header` reference template.
//
// NO LONGER A SPIKE. This began parallel to `App.astro` so the two could be
// compared side by side, and the note here said "only `/mail` uses this" long
// after that stopped being true: today NINE of the ten pages render this
// layout, and `App.astro` survives for `/login` alone — correctly, since the
// signed-out page should not show a nav rail for sections you cannot reach.
//
// ⚠️ THIS LAYOUT OWNS THE PAGE'S ONE `<main>` (below). Islands must render a
// `div`, not a `main`, or the page nests a landmark inside a landmark —
// invalid HTML, and two "main" regions for a screen reader to choose between.
// Every island rendered here now complies.
//
// The ONE exception is `LoginForm`, and it is not an exception to the rule:
// `/login` renders under `App.astro`, which has no `<main>` of its own, so
// LoginForm's is the page's only landmark. A blind sweep of "islands must not
// render main" would strip it and leave that page with none.
//
// What was taken from the template and what was not:
//
//   TAKEN     the layout and Tailwind v4. It emits an external stylesheet,
//             which `default-src 'self'` already covers, so the generated CSP
//             is untouched.
//   NOT TAKEN @headlessui/react. It is React-only (needing preact/compat) and
//             sets inline `style` attributes, which would force
//             'unsafe-inline' into style-src on the authenticated surface.
//             The drawer and the profile menu are hand-written in ShellNav.tsx
//             instead — see the note there.
//   NOT TAKEN @heroicons/react. Nine static SVG paths are inlined instead of
//             adding a dependency to ship them.
//
// The nav is driven by `lib/app/sections` exactly as `App.astro` is, so the
// section ORDER — which is a claim about what this product is, asserted by
// sections.test.ts — cannot drift between the two shells.
import ShellNav from "../components/ShellNav.tsx";
import { type SectionId } from "../lib/app/sections";
import "../styles/tailwind.css";
// STILL IMPORTED, and this is the honest boundary of the port: the CHROME is
// Tailwind, the nine islands inside it are not. Every one of them
// (AppShell 756 lines, CalendarView, ContactsApp, ApprovalsQueue, …) is styled
// by these 765 lines, so dropping the sheet would strip the interior of every
// section while the frame around it looked immaculate. Converting the islands
// is a separate job, several times this one; until then both sheets ship.
import "../styles/webmail.css";

interface Props {
  title: string;
  section?: SectionId;
  /**
   * How the slot is framed. Two genuinely different things share this layout.
   *
   * `document` (default) — a page you READ, top to bottom: settings, login
   * copy, a single form. Gets the reading padding and grows as tall as its
   * content, with the window doing the scrolling.
   *
   * `surface` — a multi-pane APP you operate: mail, contacts, approvals,
   * agents, files. Full-bleed and exactly one viewport tall, with the panes
   * inside scrolling themselves.
   *
   * Why this had to become a choice: every section was getting `py-6` plus
   * `px-4 sm:px-6 lg:px-8`, which is correct for prose and wrong for panes.
   * Contacts' four columns ended up inset from the rail AND stopping partway
   * down the window, borders terminating in mid-air over a white void —
   * "a very bad app-iFrame" (Eric, 2026-08-17). The padding said document
   * while the content was an app.
   *
   * Default stays `document` deliberately: pages opt IN, so nothing changes
   * for a page nobody has looked at yet.
   */
  frame?: "document" | "surface";
}

const { title, section, frame = "document" } = Astro.props;
// h-16 is ShellNav's sticky header, so a surface is the window minus that.
// `min-h-0` matters more than it looks: without it a flex/grid child refuses
// to shrink below its content and the inner `overflow-y-auto` never engages —
// the pane grows instead of scrolling, which is the whole bug.
// 100dvh, not 100vh (s25 T1): on mobile Safari 100vh is the LARGE viewport —
// the one with the toolbar retracted — so a 100vh surface overflows by the
// toolbar's height whenever it is showing, and the panes' bottom edge hides
// under it. dvh tracks the toolbar as it comes and goes.
const frameClass =
  frame === "surface" ? "h-[calc(100dvh-4rem)] min-h-0 overflow-hidden" : "py-6";
const innerClass = frame === "surface" ? "h-full min-h-0" : "px-4 sm:px-6 lg:px-8";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover (s25 T1): without it iOS letterboxes the page
         inside the safe area and every env(safe-area-inset-*) reads 0 — the
         bottom sheet (and T4's tab bar) pad themselves with those insets to
         clear the home indicator, so they must actually have a value. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {/* The same mark as the rail (ShellNav's Brand). Declared explicitly
        because nothing was: browsers fell back to /favicon.ico, which this
        site does not serve, so every tab showed a blank page glyph. SVG
        first for the sharp copy; sizes="any" keeps it from losing to a
        future .ico. */}
    <link rel="icon" href="/antlerO.svg" type="image/svg+xml" sizes="any" />
    <meta name="robots" content="noindex" />
    <!--
      No hand-written CSP here, same as App.astro and for the same reason: the
      policy is GENERATED (astro.config.mjs) because only the build knows the
      hashes of Astro's own inline hydration scripts. Tailwind changes nothing
      about that — its stylesheet is an external file from this origin.
    -->
  </head>
  <body class="h-full bg-white dark:bg-gray-900">
    <!--
      client:only rather than client:load — the shell is authenticated and its
      contents depend on browser-only state (the stored session), so there is
      nothing meaningful to render at build time and a server pass would only
      produce a flash of the wrong thing.
    -->
    <ShellNav client:only="preact" section={section} />

    <!-- The left padding tracks the rail's width, which is a CLIENT
         preference this server-rendered wrapper cannot know. ShellNav syncs
         it by swapping classes on this id — classes rather than an inline
         style, because `style-src` here carries no 'unsafe-inline'. The
         lg:pl-72 below is the default the first paint uses. -->
    <div id="app-content" class="lg:pl-72">
      <main class={frameClass}>
        <div class={innerClass}>
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
