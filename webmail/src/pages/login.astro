---
// The front door (s07 T7). One island, no chrome: there is no session to sign
// out of and no section to navigate to, and a nav full of disabled links is a
// poor first impression of a product you have not signed into yet.
//
// The island is both halves of the OAuth dance: it starts the redirect to
// `auth.bullmoose.cc`, and this same path is the REGISTERED redirect URI the
// code comes back to (`?code=&state=`, stripped immediately by the app's one
// history call). The paste-a-token door survives inside it as the collapsed
// fallback for origins the AS cannot redirect back to.
//
// The door is client-side for the same reason `/` is (see index.astro): the
// build is static output and the credential lives in `localStorage`, so the
// only place the question can be answered is the browser. The code→token and
// token→session exchanges are POSTs from the island — no credential ever
// needs to be in a URL for the session to exist.
import LoginForm from "../components/LoginForm.tsx";
import App from "../layouts/App.astro";
---

<App title="bullmoose — sign in" chrome={false}>
  <LoginForm client:only="preact" />
</App>
