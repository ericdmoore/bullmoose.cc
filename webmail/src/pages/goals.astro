---
// Goals (s20 T6) — the delegation contract, with an approvable plan.
//
// Approvals asks *what needs me now?*; activity says *what was done in my
// name*; this page answers the third question, the only prospective one: *what
// still stands in my name, and which checkpoints stop for me?* A goal is
// standing authority — a sentence you want to be true, the bounds you set on
// pursuing it, and a workflow whose plan you approve before anything runs.
//
// A thin static host for one Preact island, the same "SPA-in-an-island" shape
// as `/approvals` and `/activity`. Server work behind it: the `Goal/*` methods
// (services/jmap/src/methods/goal.ts), which are themselves a thin face over
// the s11 T7 jobs DAG — one row per goal holding only what cannot be derived.
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here. The styles below
// are `is:global` so they reach the island's client-rendered DOM; Astro emits
// them as a linked stylesheet, so no inline <style> hash is involved.
import GoalsApp from "../components/GoalsApp.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — goals" section="goals" frame="surface">
  <GoalsApp client:only="preact" />
</App>

<style is:global>
  /* Goals section (s20 T6). Plain CSS on the variables webmail.css already
     defines. Kept on this page rather than appended to webmail.css because
     other sections are being built in parallel against that shared file — the
     same reason approvals.astro and activity.astro carry their own blocks.

     `frame="surface"` (AppTw.astro), so this column owns the viewport and the
     PANES scroll, not the document. `min-height: 0` on the column and the grid
     is what actually permits that — a flex child will not shrink below its
     content without it. */
  .goal {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }
  .goal-head {
    flex: 0 0 auto;
    padding-inline: 24px;
  }
  .goal-head h1 { margin: 0 0 4px; font-size: 20px; }
  .goal-sub { margin: 0 0 12px; font-size: 13px; max-width: 78ch; }

  .goal-panes {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(280px, 34%) 1fr;
  }
  /* Each pane is its own scroll region, the way Mail's list and message are. */
  .goal-pane {
    min-height: 0;
    overflow-y: auto;
    padding: 0 24px 24px;
  }
  .goal-pane + .goal-pane { border-left: 1px solid var(--line); }

  /* s25 T1's 390px rule: below lg the grid is one column, so the CONTAINER
     scrolls and the panes flow — a stacked pair of fixed-height scroll regions
     overflows an unscrollable parent. */
  @media (max-width: 1023.98px) {
    .goal-panes { grid-template-columns: 1fr; overflow-y: auto; }
    .goal-pane { overflow-y: visible; min-height: auto; }
    .goal-pane + .goal-pane { border-left: none; border-top: 1px solid var(--line); }
  }

  .goal-rows { list-style: none; margin: 12px 0 0; padding: 0; }
  .goal-row {
    display: block;
    width: 100%;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 8px 0;
    background: var(--bg);
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .goal-row-on { border-color: var(--accent); }
  .goal-row-statement { display: block; font-weight: 600; margin-bottom: 4px; }
  .goal-row-status { display: block; font-size: 12.5px; }
  .goal-row-progress { display: block; font-size: 12px; color: var(--fg-muted); }
  .goal-empty { max-width: 60ch; }

  .goal-card { max-width: 78ch; }
  .goal-statement { margin: 12px 0 4px; font-size: 17px; }
  .goal-status { margin: 0 0 4px; font-weight: 600; }
  .goal-statusnote { margin: 0 0 8px; font-size: 13px; }
  .goal-fine { font-size: 12px; }

  /* The contract — the top of the card on purpose: what you handed over is the
     thing to re-read every time you are asked to widen it. */
  .goal-contract {
    margin: 12px 0;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-sunken);
  }
  .goal-clause { display: grid; grid-template-columns: 8.5rem 1fr; gap: 8px; margin: 4px 0; }
  .goal-clause dt { font-weight: 600; font-size: 12.5px; }
  .goal-clause dd { margin: 0; font-size: 13px; }
  @media (max-width: 599.98px) {
    .goal-clause { grid-template-columns: 1fr; gap: 0; }
  }

  .goal-plan {
    margin: 16px 0;
    padding: 12px;
    border: 1px solid var(--accent);
    border-radius: 8px;
  }
  .goal-plan h3 { margin: 0 0 4px; font-size: 15px; }
  .goal-plantable { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 13px; }
  .goal-plantable th, .goal-plantable td { text-align: left; padding: 4px 6px; border-bottom: 1px solid var(--line); }
  .goal-dropped td { text-decoration: line-through; opacity: 0.6; }
  .goal-input {
    width: 100%;
    font: inherit;
    padding: 4px 6px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: inherit;
  }
  .goal-question { display: block; margin: 8px 0; font-size: 12.5px; }
  .goal-question span { display: block; margin-bottom: 4px; }

  .goal-field { display: block; margin: 8px 0; font-size: 12.5px; }
  .goal-field span { display: block; margin-bottom: 4px; }
  .goal-new {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px;
    margin: 8px 0 4px;
  }

  .goal-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 8px 0; }
  .goal-primary, .goal-mini, .goal-danger {
    font: inherit;
    cursor: pointer;
    border-radius: 6px;
    border: 1px solid var(--line);
    padding: 5px 10px;
    background: var(--bg);
    color: inherit;
  }
  .goal-primary { border-color: var(--accent); font-weight: 600; }
  .goal-mini { font-size: 12px; padding: 3px 8px; }
  .goal-danger { border-color: var(--warn); }
  .goal-primary[disabled], .goal-mini[disabled], .goal-danger[disabled] { opacity: 0.5; cursor: default; }

  .goal-checkpoints, .goal-milestones { margin: 16px 0; }
  .goal-checkpoints h3, .goal-milestones h3 { margin: 0 0 4px; font-size: 15px; }
  .goal-checkpoints ul { list-style: none; margin: 8px 0; padding: 0; }
  .goal-checkpoint {
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 6px 0;
    font-size: 13px;
  }
  .goal-milestones ol { margin: 8px 0; padding-left: 18px; font-size: 13px; }
  .goal-milestone { font-weight: 600; }

  .goal-error {
    margin: 6px 0;
    padding: 6px 10px;
    background: var(--error-soft);
    color: var(--error);
    border-radius: 5px;
    font-size: 12px;
  }
</style>
