---
// The contacts section (s07 T3, sVOL 022). A thin static host; the section
// itself is one Preact island, the same "SPA-in-an-island" shape as `/mail`
// and `/agents`.
//
// Eight live JMAP methods sit behind this page and had no browser path to them
// until now — `AddressBook/get·set·changes` and
// `ContactCard/get·set·query·queryChanges·changes`
// (`services/jmap/src/methods/contacts.ts`). No server work was needed; the
// whole task was surfacing, which is what sVOL 022 predicted once the shell
// existed ("if s03.C's shell and JmapClient already existed, this would be an
// E2", `022 …md:65-69`).
//
// client:only — the section is authenticated and interactive, so it runs in
// the browser rather than at build time. (A comment in the template would land
// in the document ahead of <html>, so it lives here in the frontmatter.)
//
// No CSP is written here. It is GENERATED from `security.csp` in
// astro.config.mjs, because only the build knows the hashes of Astro's own
// inline hydration scripts — hand-writing it once already produced a page that
// rendered empty while `astro build` and the whole suite reported success
// (s03.C/devPlan.md:69-74, and the note in layouts/AppTw.astro).
import ContactsApp from "../components/ContactsApp.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — contacts" section="contacts" frame="surface">
  <ContactsApp client:only="preact" />
</App>

<style is:global>
  /* Contacts-specific layout only. Everything structural (.app, .topbar,
     .body, .sidebar, .content, .panel, .row, .pill, .actions, .toast) is
     reused from styles/webmail.css rather than restated — and these rules
     live on the page instead of in that shared stylesheet so this section can
     land without touching a file the other s07 T3 half is editing. */

  .contacts-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }
  .contacts-hint {
    font-size: 12.5px;
    margin: 0 0 12px;
  }

  .book-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
  }
  .book-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 6px 10px;
    border: none;
    border-radius: 6px;
    background: none;
    text-align: left;
  }
  .book-row:hover {
    background: var(--bg-sunken);
  }
  .book-row.is-selected {
    background: var(--accent-soft);
    font-weight: 600;
  }
  .book-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* List beside detail, collapsing to one column when there is no room for
     two — the same single-pane fallback the mail client takes at 720px. */
  .contacts-panes {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 16px;
    padding: 0 16px 16px;
    overflow: hidden;
  }

  .card-col {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* The pager is the last row and auto-advances on scroll; anchoring keeps the
       names under the pointer still when a page appends. */
    overflow-anchor: auto;
  }
  .card-pager {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0 1.25rem;
  }
  /* s34 — the bulk-selection row. The checkbox is a SIBLING of the anchor
     (see ContactsApp), so the flex container and the row's rule live on the
     <li> and the anchor is just the growing part of it. The member list
     inside .card-detail has no checkboxes and keeps its own rule. */
  .card-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 10px;
    border-bottom: 1px solid var(--line);
  }
  .card-item.is-checked {
    background: var(--accent-soft);
  }
  .card-check {
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .card-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    min-width: 0;
    flex: 1 1 auto;
    padding: 8px 10px;
    border: none;
    background: none;
    text-align: left;
    /* s25 T3 — the row became a real link (/contacts?card=…); dressed as the
       button it replaced. */
    color: inherit;
    text-decoration: none;
  }
  .card-detail .card-row {
    border-bottom: 1px solid var(--line);
  }
  .card-row:hover {
    background: var(--bg-alt);
  }
  .card-row.is-selected {
    background: var(--accent-soft);
  }

  /* The list header: select-all plus how many rows it means. */
  .card-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
  }
  .card-select-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .card-select-all input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  /* The bulk action bar — only rendered while something is selected, so it
     never occupies a row for a state the page is not in. */
  .bulk-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px 10px;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
  }
  .bulk-count {
    font-weight: 600;
  }
  .bulk-spacer {
    flex: 1;
  }
  /* [Add to group ▾] — a popover, not a <select>: arrowing a closed select
     fires change per option in some browsers, and "+ Create Group" popping a
     prompt() from an arrow key is an ambush. Same shape as CollectionBar's
     collection popover. */
  .bulk-menu {
    position: relative;
    display: inline-flex;
  }
  .bulk-menu-popover {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 20;
    margin-top: 4px;
    min-width: 15rem;
    max-height: 20rem;
    overflow-y: auto;
    padding: 4px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }
  .bulk-menu-popover p {
    margin: 0;
    padding: 6px 8px;
    font-size: 12.5px;
  }
  .bulk-menu-popover button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
  }
  .bulk-menu-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bulk-menu-create {
    margin-top: 4px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 6px 6px;
    color: var(--accent);
  }
  .bulk-bar button:not(.link-button) {
    font: inherit;
    padding: 2px 8px;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .bulk-bar .bulk-menu-popover button {
    background: none;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
  }
  .bulk-bar .bulk-menu-popover button:hover {
    background: var(--bg-alt);
  }
  .bulk-bar button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  /* Same treatment `.actions .danger` gives the single-card Delete, so the
     destructive verb reads the same at both scales. */
  .bulk-bar .danger {
    color: var(--error);
    border-color: var(--error);
  }
  .card-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .card-sub {
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-detail {
    overflow-y: auto;
    padding-bottom: 32px;
  }
  .card-detail .panel {
    margin-bottom: 0;
  }
  .card-detail h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .detail-line {
    margin: 4px 0;
  }
  .detail-line > .muted {
    display: inline-block;
    min-width: 8ch;
    font-size: 12.5px;
  }

  /* s34 — the uid, de-emphasised and clamped. Still copyable in full:
     text-overflow is a rendering effect, not a truncation of the text. */
  .card-urn {
    display: inline-block;
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
    font-size: 11.5px;
    opacity: 0.65;
  }

  .join-group {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .join-group select {
    font: inherit;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 6px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12.5px;
    color: var(--fg-muted);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
  }
  .contact-form textarea {
    min-height: 70px;
    resize: vertical;
  }
  .contact-form-pair {
    display: grid;
    grid-template-columns: 1fr 10ch;
    gap: 8px;
  }
  .contact-form-address {
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-form-address legend {
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .contacts-panes {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
  }

  /* s25 T1 — the 390px audit: same egregious bug as /mail, same fix. `.body`
     is a flex ROW, so the CollectionColumn's fixed width crushed the card
     list on a phone; below lg it stacks (the column renders itself full-width
     and height-capped there). 1023.98px = below Tailwind's lg, where the
     column swaps its own width classes. */
  @media (max-width: 1023.98px) {
    .body {
      flex-direction: column;
    }

    /* s25 T5 — clearance for the "New contact" FAB. Same rule as /mail: the
       floating button takes no space in flow, so the scroll containers pad
       themselves out from under it rather than letting it cover the last card
       (and the detail pane's own actions). 72px is `FAB_CLEARANCE_PX`
       (lib/ui/classes.ts); the inset clears the home indicator. */
    .card-list,
    .card-detail,
    .contacts-panes {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>
