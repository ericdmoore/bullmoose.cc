---
// The contacts section (s07 T3, sVOL 022). A thin static host; the section
// itself is one Preact island, the same "SPA-in-an-island" shape as `/mail`
// and `/agents`.
//
// Eight live JMAP methods sit behind this page and had no browser path to them
// until now — `AddressBook/get·set·changes` and
// `ContactCard/get·set·query·queryChanges·changes`
// (`services/jmap/src/methods/contacts.ts`). No server work was needed; the
// whole task was surfacing, which is what sVOL 022 predicted once the shell
// existed ("if s03.C's shell and JmapClient already existed, this would be an
// E2", `022 …md:65-69`).
//
// client:only — the section is authenticated and interactive, so it runs in
// the browser rather than at build time. (A comment in the template would land
// in the document ahead of <html>, so it lives here in the frontmatter.)
//
// No CSP is written here. It is GENERATED from `security.csp` in
// astro.config.mjs, because only the build knows the hashes of Astro's own
// inline hydration scripts — hand-writing it once already produced a page that
// rendered empty while `astro build` and the whole suite reported success
// (s03.C/devPlan.md:69-74, and the note in layouts/App.astro).
import ContactsApp from "../components/ContactsApp.tsx";
import App from "../layouts/App.astro";
---

<App title="bullmoose — contacts" section="contacts">
  <ContactsApp client:only="preact" />
</App>

<style is:global>
  /* Contacts-specific layout only. Everything structural (.app, .topbar,
     .body, .sidebar, .content, .panel, .row, .pill, .actions, .toast) is
     reused from styles/webmail.css rather than restated — and these rules
     live on the page instead of in that shared stylesheet so this section can
     land without touching a file the other s07 T3 half is editing. */

  .contacts-account {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .contacts-account select {
    font: inherit;
    color: inherit;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 6px;
  }

  .contacts-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }
  .contacts-hint {
    font-size: 12.5px;
    margin: 0 0 12px;
  }

  .book-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
  }
  .book-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 6px 10px;
    border: none;
    border-radius: 6px;
    background: none;
    text-align: left;
  }
  .book-row:hover {
    background: var(--bg-sunken);
  }
  .book-row.is-selected {
    background: var(--accent-soft);
    font-weight: 600;
  }
  .book-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* List beside detail, collapsing to one column when there is no room for
     two — the same single-pane fallback the mail client takes at 720px. */
  .contacts-panes {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 16px;
    padding: 0 16px 16px;
    overflow: hidden;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    /* The pager is the last row and auto-advances on scroll; anchoring keeps the
       names under the pointer still when a page appends. */
    overflow-anchor: auto;
  }
  .card-pager {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0 1.25rem;
  }
  .card-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
  }
  .card-row:hover {
    background: var(--bg-alt);
  }
  .card-row.is-selected {
    background: var(--accent-soft);
  }
  .card-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .card-sub {
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-detail {
    overflow-y: auto;
    padding-bottom: 32px;
  }
  .card-detail .panel {
    margin-bottom: 0;
  }
  .card-detail h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .detail-line {
    margin: 4px 0;
  }
  .detail-line > .muted {
    display: inline-block;
    min-width: 8ch;
    font-size: 12.5px;
  }

  .join-group {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .join-group select {
    font: inherit;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 6px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12.5px;
    color: var(--fg-muted);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
  }
  .contact-form textarea {
    min-height: 70px;
    resize: vertical;
  }
  .contact-form-pair {
    display: grid;
    grid-template-columns: 1fr 10ch;
    gap: 8px;
  }
  .contact-form-address {
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-form-address legend {
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .contacts-panes {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
  }
</style>
