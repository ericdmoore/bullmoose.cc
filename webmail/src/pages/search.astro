---
// The search section (s07 T6). A thin static host; the section itself is one
// Preact island, the same "SPA-in-an-island" shape as `/mail` and `/contacts`.
//
// This is the cross-realm STUB the plan asks for — it fans one query out to
// `Email/query` + `ContactCard/query` + `CalendarEvent/query` and NAMES its
// own limits instead of faking a universal search: mail is FTS5-indexed,
// contacts and calendar are full scans, files has no search path at all, and
// attachment contents wait on the extraction index (devPlan refinement 4).
// The scope note carrying that is derived in `lib/search/scope.ts`, and the
// planner/fan-out live in `lib/search/` as pure modules so the future MCP
// `search` tool can share them (the "same query planner" clause of T6).
//
// client:only — the section is authenticated and interactive, so it runs in
// the browser rather than at build time. (A comment in the template would land
// in the document ahead of <html>, so it lives here in the frontmatter.)
//
// No CSP is written here. It is GENERATED from `security.csp` in
// astro.config.mjs, because only the build knows the hashes of Astro's own
// inline hydration scripts — hand-writing it once already produced a page that
// rendered empty while `astro build` and the whole suite reported success
// (s03.C/devPlan.md:69-74, and the note in layouts/App.astro).
import SearchApp from "../components/SearchApp.tsx";
import App from "../layouts/App.astro";
---

<App title="bullmoose — search" section="search">
  <SearchApp client:only="preact" />
</App>

<style is:global>
  /* Search-specific layout only. Everything structural (.app, .topbar,
     .search, .search-scope, .banner, .panel, .pill, .muted) is reused from
     styles/webmail.css rather than restated — and these rules live on the
     page instead of in that shared stylesheet so this section can land
     without touching a file a parallel s07 task is editing (the same call
     contacts.astro made). */

  .search button[type="submit"] {
    font: inherit;
    color: inherit;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }
  .search button[type="submit"]:disabled {
    color: var(--fg-muted);
  }

  /* One line per coverage fact; the shared .scope-line is a results row and
     deliberately not reused here (SearchApp.tsx). */
  .search-scope .scope-item {
    display: block;
  }

  .search-results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px 16px 32px;
    max-width: 860px;
  }
  .search-hint {
    font-size: 13px;
  }

  .realm-group {
    margin-bottom: 20px;
  }
  .realm-group h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 6px;
    font-size: 15px;
    letter-spacing: 0.01em;
  }
  .realm-total {
    font-size: 12.5px;
    font-weight: 400;
  }
  /* A realm that was not searched must read as switched off, never as an
     empty result — "no matches" and "not searched" are different facts. */
  .realm-off h2 {
    color: var(--fg-muted);
  }
  .realm-off p {
    margin: 0;
    font-size: 12.5px;
  }
  .realm-error {
    display: block;
    margin: 0 0 6px;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12.5px;
  }

  .hit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hit-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 2px;
    border-bottom: 1px solid var(--line);
  }
  .hit-title {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
    max-width: 45%;
  }
  .hit-snippet {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--fg-muted);
    font-size: 13px;
  }
  .hit-when {
    font-size: 12px;
    white-space: nowrap;
    margin-left: auto;
  }
</style>
