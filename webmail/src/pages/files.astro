---
// The Files section (s03.C T3, over s03.B T1/T2's FileNode collection). A thin
// static host; the section itself is one Preact island, the same
// "SPA-in-an-island" shape as `/mail`, `/contacts` and `/calendar`.
//
// Five live JMAP methods and one HTTP route sit behind this page and had no
// browser path to them until now — `FileNode/get·set·query·changes·copy`
// (`services/jmap/src/methods/filenode.ts`) and `POST /api/upload/{accountId}`
// (`services/jmap/src/index.ts:97`). No server work was needed; the whole task
// was surfacing, which is what s03.B's plan predicted once the sidestep gave
// the drive something to hold ("this is what makes Files useful on day one").
//
// client:only — the section is authenticated and interactive, so it runs in
// the browser rather than at build time. (A comment in the template would land
// in the document ahead of <html>, so it lives here in the frontmatter.)
//
// No CSP is written here. It is GENERATED from `security.csp` in
// astro.config.mjs, because only the build knows the hashes of Astro's own
// inline hydration scripts — hand-writing it once already produced a page that
// rendered empty while `astro build` and the whole suite reported success
// (s03.C/devPlan.md:69-74, and the note in layouts/App.astro).
import FilesApp from "../components/FilesApp.tsx";
import App from "../layouts/App.astro";
---

<App title="bullmoose — files" section="files">
  <FilesApp client:only="preact" />
</App>

<style is:global>
  /* Files-specific layout only. Everything structural (.app, .topbar, .body,
     .sidebar, .content, .panel, .row, .pill, .actions, .attach, .toast,
     .banner, .empty-means, .caveats) is reused from styles/webmail.css rather
     than restated — and these rules live on the page, as the contacts section
     does, so this section can land without editing a shared stylesheet. */

  .crumbs {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    font-size: 14px;
  }
  .crumb {
    padding: 2px 4px;
    white-space: nowrap;
  }
  .crumb-here {
    font-weight: 600;
  }
  .crumb-sep {
    color: var(--fg-muted);
  }

  .files-account {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .files-account select {
    font: inherit;
    color: inherit;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 6px;
  }

  .files-newfolder {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }
  .files-newfolder label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12.5px;
  }
  .files-newfolder input,
  .files-rename input {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
  }
  .files-newfolder button,
  .files-rename button[type="submit"] {
    border: 1px solid var(--line);
    background: var(--bg);
    border-radius: 6px;
    padding: 5px 12px;
  }
  .files-newfolder button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  /* A refusal belongs where the typing happened, not in a toast that vanishes. */
  .files-problem {
    margin: 0;
    padding: 6px 8px;
    border-radius: 6px;
    background: var(--error-soft);
    color: var(--error);
    font-size: 12.5px;
  }

  .files-upload {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 14px;
  }
  .files-upload-label {
    font-size: 12.5px;
    font-weight: 600;
  }
  .files-upload input[type="file"] {
    font-size: 12px;
    max-width: 100%;
  }
  .files-hint {
    font-size: 12.5px;
    margin: 0;
  }

  .files-queue {
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .files-queue-h {
    font-size: 12.5px;
    margin: 0 0 6px;
  }
  .files-queue ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .files-queue-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    font-size: 12.5px;
  }
  .files-queue-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18ch;
  }
  .files-queue-row.is-failed .pill {
    color: var(--error);
    border-color: var(--error);
  }
  .files-queue-row.is-done .pill {
    color: var(--accent);
    border-color: var(--accent);
  }
  .files-queue-note {
    flex-basis: 100%;
    color: var(--fg-muted);
    font-size: 12px;
  }

  /* List beside detail, collapsing to one column when there is no room for
     two — the same single-pane fallback mail and contacts take. */
  .files-panes {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(240px, 340px);
    gap: 16px;
    padding: 0 16px 16px;
    overflow: hidden;
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    border: 1px dashed transparent;
    border-radius: 8px;
  }
  /* The drop target has to be VISIBLE while dragging or the gesture is a
     guess. The file input in the sidebar is the path that does not need it. */
  .file-list.is-dropping {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .file-list > li {
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid var(--line);
  }
  .file-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    border: none;
    background: none;
    text-align: left;
  }
  .file-row:hover {
    background: var(--bg-alt);
  }
  .file-row.is-selected {
    background: var(--accent-soft);
  }
  .file-icon {
    width: 1em;
    color: var(--fg-muted);
  }
  .file-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-meta {
    font-size: 12px;
    white-space: nowrap;
  }
  .file-open {
    padding-right: 10px;
  }
  .files-pager {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0 1.25rem;
    border-bottom: none;
  }

  .file-detail {
    overflow-y: auto;
    padding-bottom: 32px;
  }
  .file-detail .panel {
    margin-bottom: 0;
  }
  .file-detail h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    word-break: break-word;
  }
  .detail-line {
    margin: 4px 0;
  }
  .detail-line > .muted {
    display: inline-block;
    min-width: 8ch;
    font-size: 12.5px;
  }

  .files-rename {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 8px;
  }
  .files-rename input {
    flex: 1;
    min-width: 12ch;
  }

  @media (max-width: 900px) {
    .files-panes {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
  }
</style>
