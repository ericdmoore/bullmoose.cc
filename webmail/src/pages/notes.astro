---
// Notes (s18 N1) — the human-authored noun, and the half of the s18 split that
// was deliberately held back until the Annotation track landed.
//
// ⚠️ A note is NOT an annotation. An Annotation is a claim about your mail that
// you adjudicate, and it renders in the MARGIN of the message it is about
// (`MessageView` + `AnnotationMargin`, s18 A3). A Note is a document you
// author: standalone, no anchor, no class, no status. Two entities, resolved
// explicitly (s18 devPlan, 2026-08-17) — this page never lists the other one.
//
// Federation (s18 N3, "a private document that federates") is NOT built. The
// realm says so on its own face rather than in a comment nobody reads: see
// `lib/notes/notes.ts` NO_FEDERATION_NOTE and the disabled "Shared with me"
// collection row.
//
// A thin static host for one Preact island, the same "SPA-in-an-island" shape
// as `/activity` and `/approvals`. Server work behind it: `Note/get|set|query`
// (`services/jmap/src/methods/note.ts`), riding the existing
// `urn:bullmoose:params:jmap:agent` capability — no new URN, no new plane.
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here. The styles below
// are `is:global` so they reach the island's client-rendered DOM; Astro emits
// them as a linked stylesheet, so no inline <style> hash is involved.
import NotesApp from "../components/NotesApp.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — notes" section="notes" frame="surface">
  <NotesApp client:only="preact" />
</App>

<style is:global>
  /* Notes section (s18 N1). Plain CSS on the variables webmail.css already
     defines, kept on this page rather than appended to the shared file — the
     same reason activity.astro and approvals.astro carry their own blocks:
     other sections are being built in parallel against webmail.css.

     The page is `frame="surface"` (AppTw.astro), so this column owns the
     viewport and the PANES scroll, not the document. `min-height: 0` on both
     the column and the grid is what actually permits that. */
  .notes {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }
  .notes-head,
  .notes > .banner,
  .notes > .notes-error,
  .notes > .notes-pad {
    flex: 0 0 auto;
    padding-inline: 24px;
  }
  .notes-panes {
    flex: 1 1 auto;
    min-height: 0;
  }
  .notes-pane {
    min-height: 0;
    overflow-y: auto;
    padding: 0 24px 24px;
  }
  .notes-pane + .notes-pane {
    border-left: 1px solid var(--line);
  }
  /* The 390px shape (s25 T1): stacked, the container scrolls and the panes
     flow, and the divider turns horizontal. */
  @media (max-width: 1023.98px) {
    .notes-panes {
      overflow-y: auto;
    }
    .notes-pane {
      overflow-y: visible;
      min-height: auto;
    }
    .notes-pane + .notes-pane {
      border-left: none;
      border-top: 1px solid var(--line);
    }
  }

  .notes-head h1 { margin: 0 0 4px; font-size: 20px; }
  .notes-sub { margin: 0 0 6px; font-size: 13px; max-width: 70ch; }
  .notes-fine { font-size: 11.5px; color: var(--fg-muted); margin: 4px 0; max-width: 78ch; }
  .notes-pad { margin: 12px 0; }

  /* The editor. A textarea and an input, no rich text — s18 puts
     rich-text/CRDT editing explicitly out of scope, and a toolbar that
     produced markup nothing rendered would be a lie in the shape of a button. */
  .notes-editor {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
  }
  .notes-label {
    font-size: 11.5px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .notes-title,
  .notes-body {
    width: 100%;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px 10px;
    font: inherit;
  }
  .notes-title { font-size: 16px; font-weight: 600; }
  .notes-body {
    font-size: 13.5px;
    line-height: 1.5;
    resize: vertical;
    min-height: 16em;
    white-space: pre-wrap;
  }
  .notes-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .notes-error {
    margin: 6px 0;
    padding: 6px 10px;
    background: var(--error-soft);
    color: var(--error);
    border-radius: 5px;
    font-size: 12px;
  }
</style>
