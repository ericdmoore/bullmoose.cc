---
// The approval queue (s07 T4) — the cross-agent review surface, and the
// section the nav leads with: this product is decision-centric, and this page
// is where the deciding happens. A thin static host for one Preact island,
// the same "SPA-in-an-island" shape as `/mail`, `/agents` and `/calendar`.
//
// Server work behind it: s03.D T1's `ActionProposal` collection
// (`services/jmap/src/methods/actionProposal.ts`) — `get/query/changes/set`
// under `urn:bullmoose:params:jmap:agent`, with `/set` as the human decision
// surface. T1 deliberately stopped at the hold tray: a tier-2 approve lands
// `held` and the commit OUT of the tray is s03.D T2, so this screen renders
// the held state without claiming an egress that cannot happen. The tier-3
// approve path calls the real send gate (the capability wall, arch.md §2),
// which is why approving one demands the session's own send capability.
//
// The CSP note lives in the layout (`layouts/App.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here, because only the
// build knows the hashes of Astro's own inline hydration scripts
// (s03.C/devPlan.md:69-74). The styles below are `is:global` so they reach
// the island's client-rendered DOM; Astro emits them as a linked stylesheet,
// so no inline <style> hash is involved.
import ApprovalsQueue from "../components/ApprovalsQueue.tsx";
import App from "../layouts/App.astro";
---

<App title="bullmoose — approvals" section="approvals">
  <ApprovalsQueue client:only="preact" />
</App>

<style is:global>
  /* Approvals section (s07 T4). Plain CSS on the variables webmail.css already
     defines. Kept on this page rather than appended to webmail.css because
     /search is being built in parallel against that same shared file — the
     same reason contacts.astro and calendar.astro carry their own blocks. */

  .apq {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 16px;
    max-width: 760px;
    margin: 0 auto;
    width: 100%;
  }
  .apq-head h1 { margin: 0 0 4px; font-size: 20px; }
  .apq-sub { margin: 0 0 16px; font-size: 13px; }
  .apq-h2 { font-size: 13px; text-transform: uppercase; color: var(--fg-muted); margin: 20px 0 4px; }
  .apq-pad { margin: 12px 0; }

  .apq-row {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 10px 0;
    background: var(--bg);
  }
  /* Urgency is the expiry clock's mark, and only the expiry clock's. */
  .apq-urgent { border-color: var(--warn); }
  .apq-held { background: var(--bg-alt); }
  .apq-done { opacity: 0.85; }

  .apq-rowhead { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
  .apq-tier-3 { color: var(--error); border-color: var(--error); }
  .apq-tier-2 { color: var(--warn); border-color: var(--warn); }
  .apq-status-rejected, .apq-status-expired { text-decoration: line-through; }

  .apq-summary { margin: 2px 0; font-weight: 600; }
  .apq-rationale { margin: 4px 0; font-size: 13px; }
  .apq-evidence { margin: 2px 0; font-size: 12px; }
  .apq-body {
    margin: 6px 0;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-radius: 6px;
    font-size: 12.5px;
    white-space: pre-wrap;
    max-height: 9em;
    overflow-y: auto;
  }

  /* The two opposed marks, side by side so their directions read as a pair. */
  .apq-clocks {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin: 6px 0 2px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .apq-waited { color: var(--fg-muted); }
  .apq-expiry { color: var(--fg-muted); }
  .apq-expiry-near { color: var(--error); font-weight: 600; }
  .apq-hold { color: var(--warn); }
  /* The third clock (s11 T1): the WORK's deadline, with its correction. */
  .apq-due { color: var(--fg-muted); }
  .apq-due-correct {
    font-size: 11px;
    padding: 0 6px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .apq-fine { font-size: 11.5px; color: var(--fg-muted); margin: 4px 0; }
  .apq-warn { color: var(--warn); }
  .apq-error {
    margin: 6px 0;
    padding: 6px 10px;
    background: var(--error-soft);
    color: var(--error);
    border-radius: 5px;
    font-size: 12px;
  }

  .apq-editor {
    margin-top: 8px;
    border-top: 1px solid var(--line);
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .apq-label { display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; color: var(--fg-muted); }
  .apq-editor input[type="text"], .apq-editor textarea {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
  }
  .apq-editor textarea { resize: vertical; }
  .apq-reason { display: flex; gap: 8px; align-items: baseline; font-size: 13px; }
  /* `unsafe` is a different KIND of judgment, not a louder one — the hard
     negative of decline-taxonomy.md. It reads apart from the two quality
     reasons so it is never the reflex click. */
  .apq-reason-severe {
    color: var(--error);
    border-left: 2px solid var(--error);
    padding-left: 8px;
    margin-left: -10px;
  }

  /* The needsInfo dialogue (s10 T3): the Q&A rounds attached to a proposal,
     and the open question an info-requested row is waiting on. */
  .apq-dialogue {
    margin: 6px 0;
    padding: 6px 10px;
    border-left: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .apq-round { margin: 0; }
  .apq-question { margin: 2px 0; font-size: 12.5px; }
  .apq-answer { margin: 2px 0; font-size: 12.5px; }

  .apq-diff { margin: 6px 0; font-size: 12.5px; }
  .apq-diff summary { cursor: pointer; color: var(--fg-muted); }
  .apq-diff-text {
    margin: 6px 0;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-radius: 6px;
    font-size: 12px;
    white-space: pre-wrap;
  }
  .apq-diff-del { color: var(--error); text-decoration: line-through; }
  .apq-diff-add { color: var(--accent); }
</style>
