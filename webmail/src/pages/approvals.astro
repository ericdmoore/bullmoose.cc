---
// The approval queue (s07 T4) — the cross-agent review surface, and the
// section the nav leads with: this product is decision-centric, and this page
// is where the deciding happens. A thin static host for one Preact island,
// the same "SPA-in-an-island" shape as `/mail`, `/agents` and `/calendar`.
//
// Server work behind it: s03.D T1's `ActionProposal` collection
// (`services/jmap/src/methods/actionProposal.ts`) — `get/query/changes/set`
// under `urn:bullmoose:params:jmap:agent`, with `/set` as the human decision
// surface. T1 deliberately stopped at the hold tray: a tier-2 approve lands
// `held` and the commit OUT of the tray is s03.D T2, so this screen renders
// the held state without claiming an egress that cannot happen. The tier-3
// approve path calls the real send gate (the capability wall, arch.md §2),
// which is why approving one demands the session's own send capability.
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here, because only the
// build knows the hashes of Astro's own inline hydration scripts
// (s03.C/devPlan.md:69-74). Visual treatment is Tailwind on the island
// (`ApprovalsQueue` / `ApprovalsDetail`), so this page carries no extra CSS.
import ApprovalsQueue from "../components/ApprovalsQueue.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — approvals" section="approvals" frame="surface">
  <ApprovalsQueue client:only="preact" />
</App>
