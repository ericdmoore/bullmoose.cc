---
// The Agents realm (s26 T1) — the quad-panel surface (s24 IA): rail →
// CollectionColumn (agent groups) → the agents → the dossier. One Preact
// island, the same "SPA-in-an-island" shape as the mail client.
//
// The island renders each binding's DOSSIER — identity, economics (budget cap
// vs month spend, the model menu, the frontier rate), and the work ledger —
// over the `/console/*` reads served same-origin by `services/jmap/src/
// console.ts` (extended for this slice with economics + ledger projections).
//
// s03.E's agent/credential console is NOT gone: it kept its entry point as
// the realm's Governance collection ("Access console"), where the island
// mounts `AgentConsole` whole — per-agent authorization, the forensic view
// and the credential vault flows, unchanged.
//
// The CSP note is in the layout (`layouts/AppTw.astro`); `form-action 'none'`
// is load-bearing here in particular, since the credential surfaces must post
// with `fetch` to the vault origin and never as a form.
import AgentsApp from "../components/AgentsApp.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — agents" section="agents" frame="surface">
  <AgentsApp client:only="preact" />
</App>
