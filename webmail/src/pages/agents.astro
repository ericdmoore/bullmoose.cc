---
// The agent/credential console (s03.E), at `/agents` since s07 T1 — the nav is
// eight nouns and this is the "agents" one; nothing external pinned `/console`.
// Still its own page with one Preact island, the same "SPA-in-an-island" shape
// as the mail client.
//
// Its own page rather than a pane inside the mail shell: the two views are
// full screens ("Both questions are answerable in one screen each" —
// readme.md Acceptance 1), and a governance surface that only exists while a
// thread is open is a governance surface nobody opens.
//
// ⚠️ This is s03.E's console, not s07 T4's `/agents`. T4 wants the per-agent
// dossier — pending queue, approved/declined history, the three cost numbers —
// and needs four `/console/*` routes that do not exist yet. What is here is
// honest about that on its own (`AgentConsole.tsx:264`).
//
// The CSP note is in the layout (`layouts/AppTw.astro`); `form-action 'none'` is
// load-bearing on this page in particular, since the credential surfaces must
// post with `fetch` to the vault origin and never as a form.
import AgentConsole from "../components/AgentConsole.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — agent console" section="agents" frame="surface">
  <AgentConsole client:only="preact" />
</App>
