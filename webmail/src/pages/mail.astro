---
// The mail section (s03.C · T2, moved to `/mail` by s07 T1). The Astro page is
// a thin static host; the mail client is one Preact island (arch.md §1,
// "SPA-in-an-island").
//
// It moved off `/` because `/` is not a section: home is the Looking Ahead +
// Waiting Approvals view (s07 T0), and leaving the mail client there would
// have made the product "a mail client with extras" by default — the exact
// claim the s07 devPlan's nav ordering argues against.
//
// client:only — the shell is authenticated and interactive, so it runs in the
// browser rather than being rendered at build time. (A comment out here in the
// template would land in the document ahead of <html>, so it lives in the
// frontmatter.)
// s07 nav spike: this ONE page renders inside the Tailwind sidebar+header
// shell (AppTw.astro) while every other section stays on the hand-written
// chrome (App.astro). That is the point of a spike — the two shells run in the
// same app so the feel can be judged directly, and reverting is this import.
import AppShell from "../components/AppShell.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose webmail" section="mail" frame="surface">
  <AppShell client:only="preact" />
</App>

<style is:global>
  /* ── the margin (s18 A3) — annotations in-situ, below the message card ──
     Global because the island renders these classes at runtime; no inline
     styles (CSP). Collapsed to one small chip by default so the reading
     surface stays calm. Class accents ride the left border. */
  .anno-margin {
    margin: -6px 0 14px;
    padding-left: 14px;
  }
  .anno-chip {
    border: 1px solid var(--line);
    background: var(--bg-alt);
    color: var(--fg-muted);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 12px;
    cursor: pointer;
  }
  .anno-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .anno-note {
    border: 1px solid var(--line);
    border-left: 3px solid var(--fg-muted);
    border-radius: 6px;
    background: var(--bg-alt);
    padding: 8px 12px;
    font-size: 13px;
    max-width: 640px;
  }
  .anno-commitment {
    border-left-color: var(--accent);
  }
  .anno-decision {
    border-left-color: var(--warn);
  }
  .anno-closed {
    opacity: 0.55;
  }
  .anno-head {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .anno-class {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .anno-author,
  .anno-status {
    font-size: 11.5px;
    color: var(--fg-muted);
  }
  .anno-status {
    margin-left: auto;
    font-style: italic;
  }
  .anno-claim {
    margin: 4px 0 2px;
    line-height: 1.4;
  }
  .anno-why {
    margin: 0;
    font-size: 12px;
    font-style: italic;
    color: var(--fg-muted);
  }
  .anno-verbs {
    display: flex;
    gap: 8px;
    margin: 8px 0 0;
  }
  .anno-verbs button {
    border: 1px solid var(--line);
    background: var(--bg);
    border-radius: 5px;
    padding: 2px 10px;
    font-size: 12px;
    cursor: pointer;
  }
  .anno-verbs button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .anno-error {
    margin: 8px 0 0;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    color: var(--error);
    background: var(--error-soft);
    max-width: 640px;
  }

  /* ── the person-panel (the A3 rider): open items in this thread ── */
  .person-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-alt);
    padding: 10px 14px;
    margin: 0 0 12px;
  }
  .person-panel-head {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .person-panel-title {
    font-size: 13.5px;
    font-weight: 600;
  }
  .person-panel-sub {
    font-size: 12px;
    color: var(--fg-muted);
  }
  .person-panel-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  .person-item {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 3px 0;
    font-size: 13px;
  }
  .person-item-class {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    flex: none;
  }
  .person-item-body {
    min-width: 0;
  }
</style>
