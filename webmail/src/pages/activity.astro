---
// Activity (s23 v1) — the retrospective twin of `/approvals`. The queue asks
// *what needs me?*; this page answers *what was decided without me, and on
// whose authority?* Decided proposals deliberately LEFT the approvals queue
// in s24 T4 (history bloats a decision surface); this is where they went,
// alongside the watches the cron already fired.
//
// A thin static host for one Preact island, the same "SPA-in-an-island" shape
// as `/approvals` and `/mail`. Server work behind it: none new — the feed is
// a read model over collections that already exist (`ActionProposal/*` and
// `Watch/*`, both under `urn:bullmoose:params:jmap:agent`).
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here. The styles below
// are `is:global` so they reach the island's client-rendered DOM; Astro emits
// them as a linked stylesheet, so no inline <style> hash is involved.
import ActivityApp from "../components/ActivityApp.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — activity" section="activity" frame="surface">
  <ActivityApp client:only="preact" />
</App>

<style is:global>
  /* Activity section (s23 v1). Plain CSS on the variables webmail.css already
     defines. Kept on this page rather than appended to webmail.css because
     other sections are being built in parallel against that same shared file —
     the same reason approvals.astro and contacts.astro carry their own blocks.

     The page is `frame="surface"` (AppTw.astro), so this column owns the
     viewport and the PANES scroll, not the document. `min-height: 0` on both
     the column and the grid is what actually permits that — a flex child will
     not shrink below its content without it. */
  .act {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }
  /* The title block is fixed chrome; only the panes below it scroll. */
  .act-head,
  .act > .banner,
  .act > .act-error,
  .act > .act-pad {
    flex: 0 0 auto;
    padding-inline: 24px;
  }
  .act-panes {
    flex: 1 1 auto;
    min-height: 0;
  }
  /* Each pane is its own scroll region, the way Mail's list and message are. */
  .act-pane {
    min-height: 0;
    overflow-y: auto;
    padding: 0 24px 24px;
  }
  .act-pane + .act-pane {
    border-left: 1px solid var(--line);
  }
  /* s25 T1 — the 390px audit: same fix as /approvals. Below lg the grid is
     one column but each pane kept its own fixed-height scroll region, so the
     stack overflowed an unscrollable container. Stacked, the container
     scrolls and the panes flow; the divider turns horizontal. */
  @media (max-width: 1023.98px) {
    .act-panes {
      overflow-y: auto;
    }
    .act-pane {
      overflow-y: visible;
      min-height: auto;
    }
    .act-pane + .act-pane {
      border-left: none;
      border-top: 1px solid var(--line);
    }
  }
  .act-head h1 { margin: 0 0 4px; font-size: 20px; }
  .act-sub { margin: 0 0 12px; font-size: 13px; max-width: 70ch; }
  .act-pad { margin: 12px 0; }

  /* The record card — the approvals row's shape, minus every verb. Slightly
     muted by construction: everything here is already settled. */
  .act-row {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 10px 0;
    background: var(--bg);
    opacity: 0.95;
  }
  .act-rowhead { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
  /* Outcome marks: a decline reads struck through, everywhere it renders. */
  .act-status-rejected, .act-status-expired { text-decoration: line-through; }
  .act-status-yanked { color: var(--warn); border-color: var(--warn); }
  .act-status-fired { color: var(--accent); border-color: var(--accent); }

  .act-summary { margin: 2px 0; font-weight: 600; }
  /* The line the section exists for — who decided, on what grounds. */
  .act-decision { margin: 4px 0; font-size: 13px; font-weight: 600; }
  .act-when {
    margin: 4px 0 2px;
    font-size: 12px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .act-rationale { margin: 4px 0; font-size: 13px; }
  .act-evidence { margin: 2px 0; font-size: 12px; }
  .act-body {
    margin: 6px 0;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-radius: 6px;
    font-size: 12.5px;
    white-space: pre-wrap;
    max-height: 14em;
    overflow-y: auto;
  }
  .act-fine { font-size: 11.5px; color: var(--fg-muted); margin: 4px 0; }
  .act-error {
    margin: 6px 0;
    padding: 6px 10px;
    background: var(--error-soft);
    color: var(--error);
    border-radius: 5px;
    font-size: 12px;
  }
</style>
