---
// The webmail app (s03.C · T2). The Astro page is a thin static host; the mail
// client is one Preact island (arch.md §1, "SPA-in-an-island").
import AppShell from "../components/AppShell.tsx";
import "../styles/webmail.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>bullmoose webmail</title>
    <meta name="robots" content="noindex" />
    <!--
      No hand-written CSP here on purpose. Sender HTML is sanitized before it
      reaches the DOM (lib/mail/sanitize.ts) and CSP is the second half of that
      defence (arch.md §4), but the policy is GENERATED — `security.csp` in
      astro.config.mjs — because only the build knows the hashes of Astro's own
      inline hydration scripts. Writing `script-src 'self'` by hand here blocks
      that bootstrap and the island silently never mounts.
      `frame-ancestors` lives in public/_headers; <meta> ignores it.
    -->
  </head>
  <body>
    <!-- client:only — the shell is authenticated and interactive, so it runs in
         the browser rather than being rendered at build time. -->
    <AppShell client:only="preact" />
  </body>
</html>
