---
// The home VIEW (s07 T0) — *Looking Ahead* + *Waiting Approvals*.
//
// `/` is the thing that makes this a collaboration space for people and agents
// rather than a file manager with a notifications tray (s07 devPlan, "What this
// is NOT"): you arrive to DECIDE something, not to find something. It is a VIEW,
// not a section — the brand in the nav, never a ninth nav item — and the eight
// nouns are where you drill down. This replaces the interim `HomeRedirect`
// placeholder wholesale, now that s07 T4 produces the proposals it renders.
//
// One `client:only` island, chrome on: unlike the door, home wants the section
// nav so a decision can lead straight into the noun it belongs to. The island
// keeps `/`'s one non-negotiable job — an unauthenticated visitor is sent to
// `/login`, never shown a convincing sample home (lib/app/client.ts).
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written, because only the build
// knows the hashes of Astro's own inline hydration scripts (s03.C/devPlan.md:
// 69-74). The styles below are `is:global` so they reach the island's
// client-rendered DOM; Astro still emits them as a linked stylesheet, so no
// inline <style> hash is involved. Kept on this page rather than in webmail.css
// for the same reason every other section keeps its own block.
import HomeView from "../components/HomeView.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose">
  <HomeView client:only="preact" />
</App>

<style is:global>
  .home {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 16px;
  }
  .home-pad { padding: 8px 2px; }
  .home-fine { font-size: 11.5px; }
  .home-error { padding: 16px; }
  .home-error-line {
    background: var(--error-soft);
    color: var(--error);
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 12.5px;
    margin: 6px 0;
  }

  .home-banner {
    margin: 0 0 12px;
    padding: 8px 12px;
    background: var(--warn-soft);
    color: var(--warn);
    border-radius: 8px;
    font-size: 12.5px;
  }

  /* Two stacks side by side on a wide screen; Waiting Approvals leads. */
  .home-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (max-width: 820px) {
    .home-cols { grid-template-columns: 1fr; }
  }

  .home-stack { min-width: 0; }
  .home-stack-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .home-h2 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; margin: 0; }
  .home-more {
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .home-more:hover { text-decoration: underline; }
  .home-more-row {
    display: block;
    padding: 8px 10px;
    margin-top: 8px;
    border: 1px dashed var(--line);
    border-radius: 8px;
    text-align: center;
  }

  /* ── Waiting Approvals row ── */
  .home-row {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 10px;
    background: var(--bg);
  }
  .home-urgent { border-color: var(--warn); box-shadow: 0 0 0 1px var(--warn) inset; }
  .home-rowhead { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
  .pill {
    font-size: 11px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--fg-muted);
  }
  .home-tier-3 { color: var(--error); border-color: var(--error); }
  .home-tier-2 { color: var(--warn); border-color: var(--warn); }
  .home-summary { margin: 2px 0; font-weight: 600; }
  .home-rationale { margin: 2px 0 6px; font-size: 12.5px; color: var(--fg-muted); }

  .home-clocks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 6px 0;
    font-size: 12px;
  }
  .home-waited { color: var(--fg-muted); }
  .home-expiry { color: var(--fg-muted); }
  .home-expiry-near { color: var(--warn); font-weight: 600; }
  .home-warn {
    color: var(--warn);
    background: var(--warn-soft);
    padding: 5px 8px;
    border-radius: 6px;
    margin: 6px 0;
  }

  .home-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .home-actions button {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12.5px;
  }
  .home-actions button:hover:not(:disabled) { background: var(--bg-sunken); }
  .home-actions button:disabled { opacity: 0.5; cursor: default; }
  .home-danger { color: var(--error); }

  .home-editor {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .home-label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--fg-muted); }
  .home-editor input[type="text"], .home-editor textarea {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
  }
  .home-editor textarea { resize: vertical; }
  .home-reason { display: flex; gap: 8px; align-items: baseline; font-size: 12.5px; }
  /* The hard negative reads apart from the two quality reasons (see
     approvals.astro; decline-taxonomy.md). */
  .home-reason-severe {
    color: var(--error);
    border-left: 2px solid var(--error);
    padding-left: 8px;
    margin-left: -10px;
  }

  /* ── Looking Ahead ── */
  .home-horizon { list-style: none; margin: 0; padding: 0; }
  .home-hz { margin-bottom: 6px; }
  .home-hz-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
  }
  .home-hz-link:hover { background: var(--bg-alt); }
  .home-hz-expiring .home-hz-link { border-left-color: var(--warn); }
  .home-hz-hold .home-hz-link { border-left-color: var(--fg-muted); }
  .home-hz-tag {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--fg-muted);
    flex: 0 0 auto;
    min-width: 4.5rem;
  }
  .home-hz-tag-expiring { color: var(--warn); }
  .home-hz-title { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .home-hz-agent {
    font-size: 11px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--fg-muted);
    flex: 0 0 auto;
  }
  .home-hz-clock { font-size: 11.5px; color: var(--fg-muted); flex: 0 0 auto; }

  /* s18 A4 — the Waiting-on / Commitments glances. A claim is a sentence, so
     the body WRAPS (unlike the one-line horizon rows); the confidence badge, if
     any, sits to its right. */
  .home-annos { list-style: none; margin: 0; padding: 0; }
  .home-anno {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    border-left: 2px solid var(--line);
    margin-bottom: 6px;
    border-radius: 0 6px 6px 0;
  }
  .home-anno:hover { background: var(--bg-alt); }
  .home-anno-body { flex: 1 1 auto; min-width: 0; font-size: 13px; line-height: 1.35; }
  .home-anno-conf {
    flex: 0 0 auto;
    font-size: 11px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* The verbs. Quiet until the row is hovered or something inside it has
     focus — a glance is for NOTICING, and two buttons shouting on every row
     turns a short list into a control panel. `:focus-within` is what keeps
     that honest for the keyboard: tab into a row and the verbs appear, so
     they are never reachable-but-invisible. */
  .home-anno-verbs {
    flex: 0 0 auto;
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 120ms ease-out;
  }
  .home-anno:hover .home-anno-verbs,
  .home-anno:focus-within .home-anno-verbs {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-anno-verbs { transition: none; }
  }
  /* Coarse pointers have no hover, so the verbs are simply always visible. */
  @media (hover: none) {
    .home-anno-verbs { opacity: 1; }
  }
  .home-anno-verbs button {
    font: inherit;
    font-size: 11.5px;
    padding: 1px 7px;
    color: var(--fg-muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }
  .home-anno-verbs button:hover:not(:disabled) { color: var(--fg); background: var(--bg); }
  .home-anno-verbs button:disabled { opacity: 0.5; cursor: default; }
  .home-anno-failed { flex: 0 0 auto; font-size: 11px; color: var(--warn); }
</style>
