---
// The calendar section (s07 T3). A thin static host for one Preact island,
// the same "SPA-in-an-island" shape as `/mail` and `/agents`.
//
// Its own page rather than a pane in the mail shell, per the s07 devPlan's
// refinement 2: `/calendar` is a real URL that returns a real document, nobody
// reading mail downloads the calendar bundle, and there is no router to shim
// history against.
//
// Server work needed: none. `Calendar/get·set·changes` and
// `CalendarEvent/get·set·query·queryChanges·changes·getOccurrences` all serve
// today (`services/jmap/src/methods/calendars.ts`). One caveat on that count:
// `CalendarEvent/queryChanges` is registered and ALWAYS throws
// `cannotCalculateChanges` (`calendars.ts:392-394`, sVOL `026`), so it is live
// in the sense of "registered", not in the sense of "usable" — this screen
// never calls it, and re-queries the window instead.
//
// The CSP note lives in the layout (`layouts/AppTw.astro`): the policy is
// GENERATED by `astro.config.mjs`, never hand-written here, because only the
// build knows the hashes of Astro's own inline hydration scripts. The styles
// below are `is:global` so they reach the island's client-rendered DOM (Astro's
// scoping stamps attributes on this template's markup only, and the island's
// markup does not exist at build time); Astro still emits them as a linked
// stylesheet, so no inline <style> hash is involved.
import CalendarView from "../components/CalendarView.tsx";
import App from "../layouts/AppTw.astro";
---

<App title="bullmoose — calendar" section="calendar">
  <CalendarView client:only="preact" />
</App>

<style is:global>
  /* Calendar section (s07 T3). Plain CSS on the variables webmail.css already
     defines — no framework, no CDN, so the bundle stays honest and the CSP on
     this origin can stay strict. Kept in this page rather than appended to
     webmail.css because /contacts and /settings are being built in parallel
     against that same shared file. */
  .cal {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .cal-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .cal-nav { display: flex; align-items: center; gap: 6px; }
  .cal-nav button,
  .cal-view,
  .cal-actions button {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 4px 10px;
  }
  .cal-nav button:hover, .cal-view:hover { background: var(--bg-alt); }
  .cal-title { font-size: 16px; margin: 0 0 0 8px; font-weight: 600; }
  .cal-views { display: flex; gap: 4px; }
  .cal-view-on { background: var(--accent-soft); border-color: var(--accent); }
  .cal-search { margin-left: auto; display: flex; gap: 6px; align-items: center; }
  .cal-search input {
    padding: 5px 8px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--fg);
    min-width: 14rem;
  }

  .cal-note, .cal-fine { font-size: 11px; color: var(--fg-muted); }
  .cal-note { margin: 4px 12px; }
  .cal-fine { margin: 6px 0; }
  .cal-warn {
    margin: 8px 12px;
    padding: 6px 10px;
    background: var(--warn-soft);
    color: var(--warn);
    border-radius: 5px;
    font-size: 12px;
  }
  .cal-notice {
    margin: 8px 12px;
    padding: 6px 10px;
    background: var(--accent-soft);
    border-radius: 5px;
    font-size: 12px;
    cursor: pointer;
  }
  .cal-error, .cal-fatal {
    background: var(--error-soft);
    color: var(--error);
    padding: 8px 10px;
    border-radius: 5px;
    font-size: 12px;
    margin: 8px 0;
  }
  .cal-fatal { margin: 16px; }

  .cal-body { display: flex; flex: 1 1 auto; min-height: 0; }
  .cal-side {
    width: 15rem;
    flex: 0 0 auto;
    border-right: 1px solid var(--line);
    padding: 10px 12px;
    overflow-y: auto;
  }
  .cal-side h2 { font-size: 12px; text-transform: uppercase; color: var(--fg-muted); margin: 0 0 6px; }
  .cal-list { list-style: none; margin: 0 0 12px; padding: 0; }
  .cal-list label { display: flex; align-items: center; gap: 6px; padding: 3px 0; cursor: pointer; }
  .cal-swatch { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 auto; }
  .cal-primary {
    width: 100%;
    padding: 6px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 5px;
  }
  .cal-danger { color: var(--error); }

  .cal-grid-wrap { flex: 1 1 auto; min-width: 0; overflow: auto; padding: 8px; }

  /* ── month ── */
  .cal-month { display: flex; flex-direction: column; min-height: 100%; }
  .cal-month-head, .cal-month-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
  .cal-dow { font-size: 11px; color: var(--fg-muted); text-align: center; padding: 4px 0; }
  .cal-month-grid { flex: 1 1 auto; grid-auto-rows: minmax(5.5rem, 1fr); }
  .cal-cell { border: 1px solid var(--line); margin: -1px 0 0 -1px; padding: 2px; min-width: 0; }
  .cal-cell-out { background: var(--bg-alt); }
  .cal-cell-today { background: var(--accent-soft); }
  .cal-daynum {
    background: none;
    border: none;
    font-size: 12px;
    color: var(--fg-muted);
    padding: 1px 4px;
    border-radius: 4px;
  }
  .cal-daynum:hover { background: var(--bg-sunken); }
  .cal-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .cal-chip {
    display: flex;
    gap: 4px;
    width: 100%;
    text-align: left;
    background: var(--bg-alt);
    border: none;
    border-left: 3px solid var(--accent);
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
  }
  .cal-chip:hover { background: var(--bg-sunken); }
  .cal-chip-allday { background: var(--accent-soft); }
  .cal-chip-time { color: var(--fg-muted); flex: 0 0 auto; }
  .cal-chip-title { overflow: hidden; text-overflow: ellipsis; }
  .cal-chip-more { margin-left: auto; color: var(--fg-muted); }

  /* ── week / day ── */
  .cal-time { display: flex; flex-direction: column; min-height: 100%; }
  .cal-time-head, .cal-allday, .cal-time-body { display: grid; }
  .cal-time-day {
    background: none;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 4px;
    font-size: 12px;
  }
  .cal-time-today { background: var(--accent-soft); font-weight: 600; }
  .cal-allday { border-bottom: 1px solid var(--line); min-height: 1.6rem; }
  .cal-time-gutter { font-size: 10px; color: var(--fg-muted); padding: 2px 4px; text-align: right; }
  .cal-allday-cell { border-left: 1px solid var(--line); padding: 1px; display: flex; flex-direction: column; gap: 1px; }
  .cal-time-body { flex: 1 1 auto; }
  .cal-hours, .cal-daycol { display: flex; flex-direction: column; position: relative; }
  .cal-daycol { border-left: 1px solid var(--line); }
  .cal-hour { height: 2.6rem; border-top: 1px solid var(--line); flex: 0 0 auto; }
  .cal-hours .cal-hour { border-top: none; text-align: right; padding-right: 4px; font-size: 10px; color: var(--fg-muted); }
  .cal-event {
    position: absolute;
    /* A 15-minute event is 1% of the day column — a hairline nobody can read
       or click. `place.ts` reports the true minutes; the floor is presentation
       only, so the geometry stays honest and the target stays hittable. */
    min-height: 1.15rem;
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 3px;
    font-size: 11px;
    padding: 1px 3px;
    overflow: hidden;
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  /* ── search results ── */
  .cal-hits { list-style: none; margin: 0; padding: 0; }
  .cal-hits button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 6px 4px;
  }
  .cal-hits button:hover { background: var(--bg-alt); }

  /* ── editor ── */
  .cal-editor {
    width: 20rem;
    flex: 0 0 auto;
    border-left: 1px solid var(--line);
    padding: 10px 12px;
    overflow-y: auto;
    background: var(--bg-alt);
  }
  .cal-editor h2 { font-size: 14px; margin: 0 0 8px; }
  .cal-editor label { display: block; font-size: 12px; color: var(--fg-muted); margin: 6px 0; }
  .cal-editor input, .cal-editor select, .cal-editor textarea {
    display: block;
    width: 100%;
    padding: 4px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }
  .cal-editor .cal-inline { display: flex; align-items: center; gap: 5px; }
  .cal-editor .cal-inline input[type="checkbox"] { width: auto; }
  .cal-editor .cal-inline input[type="number"] { width: 5rem; }
  .cal-when { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .cal-repeat { border: 1px solid var(--line); border-radius: 5px; padding: 6px 8px; margin: 8px 0; }
  .cal-repeat legend { font-size: 11px; color: var(--fg-muted); }
  .cal-repeat select, .cal-repeat input { margin: 4px 0; }
  .cal-days { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0; font-size: 11px; }
  .cal-days label { margin: 0; }
  .cal-frozen {
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 6px 8px;
    margin: 8px 0;
    font-size: 12px;
    background: var(--bg);
  }
  .cal-actions { display: flex; gap: 6px; margin-top: 10px; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .cal-body { flex-direction: column; }
    .cal-side, .cal-editor { width: auto; border: none; border-bottom: 1px solid var(--line); }
  }
</style>
