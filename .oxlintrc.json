{
  // Why oxlint.
  //
  // `verify` already fails on `gofmt -l` and `go vet`, so Go had two gates and
  // TypeScript had none — the gap s06 named and never closed. This closes it.
  // It lints the whole tree, 425 files and ~139k lines, in under three seconds,
  // which is the difference between a check that runs on every commit and one
  // people learn to skip.
  //
  // FORMATTING LIVES IN `.oxfmtrc.json`, not here. This file's earlier note
  // argued a formatter would "conflict with every branch in flight" — true when
  // written, false by the time it mattered: the window narrowed to two
  // one-commit branches and the reformat landed there. Rule names here stay
  // eslint-compatible, so moving to eslint later is a config translation
  // rather than a rewrite.
  //
  // TYPE-AWARE IS ON. `npm run lint` is `oxlint --type-aware`, which needs the
  // `oxlint-tsgolint` devDependency (it ships per-platform binaries the same way
  // oxlint does, so `npm ci` on CI's linux-x64 gets the right one).
  //
  // Turning it on took TWO tsconfig changes, not the one originally predicted:
  //   1. the `paths` entries had to become `./packages/…` — oxlint rejects
  //      non-relative `paths` outright; and
  //   2. `baseUrl` had to GO. TypeScript-Go removed the option, so tsgolint
  //      errors on it. This was the SILENT one: with an invalid tsconfig the
  //      linter still runs and still reports, it just has NO type information —
  //      so `no-floating-promises` found nothing and looked like a clean tree.
  //      A canary (a deliberate un-awaited promise) is how that was caught.
  //      If this rule ever reports zero on a tree you doubt, plant one.
  "plugins": ["eslint", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unused-expressions": "error",

    // -- Type-aware: the promise family --------------------------------------
    // The reason this repo went type-aware at all. A dropped `await` on a D1
    // write (`env.DB.prepare(…).run()`) is silent data loss that no test
    // reliably catches, and only type information can see it.
    //
    // Both are at ZERO across the tree — verified with a canary, not assumed —
    // so they cost nothing to enforce and exist to keep it that way.
    // Fire-and-forget is still allowed: write `void foo()` and the rule is
    // satisfied, which states the intent in the code instead of in a comment.
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",

    // Same bug class one step over: an async function passed where a sync
    // callback is expected, so the caller never awaits it. WARN, not error,
    // because the live sites are all async handlers on JSX attributes in code
    // this PR must not touch. Promote to "error" once they are cleaned up.
    "typescript/no-misused-promises": "warn",

    // -- Type-aware: on for source, relaxed in tests (see overrides) ----------
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-spread": "error",

    // -- Type-aware: OFF, and why --------------------------------------------
    // These two are the overwhelming majority of what type-aware produces here,
    // and they are one symptom with one cause: D1 hands back `unknown` column
    // values, so every `${row.foo}` and every `${err}` in a catch is "an invalid
    // type in a template literal". They are not bugs — they are the shape of an
    // untyped row. Fixing them means either `String(…)` at ~171 call sites or
    // typing every D1 row, which is a real piece of work and a different PR
    // (and the row types would be the actual win, not the linting).
    // Off on purpose rather than undiscovered — flip one to "warn" to see them.
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",

    // `.sort()` on arrays of strings, where the default lexicographic sort is
    // exactly what the caller wants. Correct as written.
    "typescript/require-array-sort-compare": "off",

    // The unicorn stylistic rules found 23 real instances and not one was a bug
    // — useless spreads, `new Array(n)`, empty fallbacks. Enabling them means 23
    // churn edits across files other people are working in, to fix nothing. Off
    // on purpose rather than undiscovered: flip one to "warn" and re-run to see
    // the list again.
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      // Test files construct things on purpose that are wrong in source: a
      // `new Function(…)` built to prove the guard against it fires, a string
      // spread used as a fixture. Relaxed HERE rather than globally so the
      // rules keep covering packages/ and services/.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-implied-eval": "off",
        "typescript/no-misused-spread": "off"
      }
    },
    {
      // Our Astro+Preact ports of the Tailwind UI templates, generated by
      // `webmail/referenceTemplates/astro/_generate.mjs`. They are 1:1 with the
      // licensed React source, and twelve of the identifiers upstream declares
      // are ones upstream never uses — eight unused heroicon imports in one
      // command palette, two unused `items` arrays, one unused `classNames`.
      //
      // Deleting them would make the port stop matching the file it documents
      // (and the generator would put them straight back on the next run), so
      // the dead code is kept deliberately and this rule is off HERE ONLY.
      // Every other rule still applies: `correctness` is what catches a
      // template that does not parse, which is exactly how 125 unparseable
      // icon components merged in #219 while this subtree was unlinted.
      "files": ["webmail/referenceTemplates/astro/**"],
      "rules": {
        "eslint/no-unused-vars": "off",
        // Same reason, one rule over: the generated `_kit/headless.tsx` widens
        // an element-name union with `string`, which IS redundant and IS what
        // upstream wrote. Editing it would break the 1:1 the port documents.
        "typescript/no-redundant-type-constituents": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".claude/worktrees/**",
    "**/*.d.ts",
    "webmail/public/**",
    // Licensed Tailwind UI templates, vendored verbatim. They are reference
    // material we copy FROM, never source we edit — linting them would demand
    // changes we are not entitled to make. Scoped to the vendored subtree
    // only: `referenceTemplates/astro/**` is OUR port of them and is linted.
    "webmail/referenceTemplates/tailwindcss.com/**"
  ]
}
