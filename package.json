{
  "name": "bullmoose-mail",
  "private": true,
  "description": "Serverless JMAP mail platform — Cloudflare Workers + Durable Objects + D1 + R2, SES outbound",
  "workspaces": [
    "packages/*",
    "services/*",
    "webmail"
  ],
  "scripts": {
    "build:cli": "npm run -w @bullmoose/cli build",
    "coverage": "vitest run --coverage",
    "coverage:baseline": "node .github/scripts/coverage-ratchet.mjs --update",
    "coverage:ratchet": "node .github/scripts/coverage-ratchet.mjs",
    "dev:ingest": "npm run dev -w services/ingest",
    "dev:jmap": "npm run dev -w services/jmap",
    "dev:provision": "npm run dev -w services/provision",
    "dev:submit": "npm run dev -w services/submit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:conformance": "UPDATE_CONFORMANCE=1 vitest run conformance",
    "lint": "oxlint",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run -w webmail typecheck && npm run -w @bullmoose/cli typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.20.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "undici": "^7.29.0"
  }
}
