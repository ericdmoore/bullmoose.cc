{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // 120, not the default 100. The codebase's real p99 line is 107 and it leans
  // hard on table-driven tests, where one case per line is the entire point of
  // the pattern. At 100 every such row explodes into 4-6 lines and the table
  // stops being scannable: measured net +8988 lines at 100 vs +1922 at 120,
  // and at 120 files like packages/mailstore/src/sieve.test.ts are untouched.
  "printWidth": 120,

  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".claude/worktrees/**",
    "**/*.d.ts",
    "webmail/public/**",

    // Licensed Tailwind UI templates, vendored verbatim. We copy FROM them,
    // never edit them — reformatting is a change we are not entitled to make.
    // oxfmt only honours .gitignore/.prettierignore by default, and these are
    // committed, so nothing else protects them. Scoped to the vendored subtree
    // only: `referenceTemplates/astro/**` is OUR port of them and is formatted.
    "webmail/referenceTemplates/tailwindcss.com/**",

    // Generated by `npm run gen:conformance`. Formatting it means the
    // generator and the formatter rewrite each other forever.
    "conformance/**",

    // Golden files: their exact bytes ARE the assertion. Reformatting one does
    // not "tidy" it, it rewrites the expected output — and the test would then
    // pass against whatever the formatter preferred. Same reasoning as
    // conformance/ above, one layer further in.
    "cli-go/internal/markdown/testdata/**",

    // The s21 explorer toggle works by uncommenting exact lines in
    // services/jmap/wrangler.jsonc, so the literal text is load-bearing and
    // infra/explorer.test.ts asserts on it. oxfmt also adds trailing commas
    // here, which is legal JSONC but noise in files wrangler owns.
    "**/*.jsonc",

    // Prose is hand-wrapped and argued over. Formatting it re-indents nested
    // bullets across 202 files to fix nothing, and lands in .plans/ where
    // other people are actively writing.
    "**/*.md"
  ]
}
