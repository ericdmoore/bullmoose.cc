{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@bullmoose/auth-core": ["packages/auth-core/src/index.ts"],
      "@bullmoose/auth-core/principal": ["packages/auth-core/src/principal.ts"],
      "@bullmoose/contacts-core": ["packages/contacts-core/src/index.ts"],
      "@bullmoose/calendar-core": ["packages/calendar-core/src/index.ts"],
      "@bullmoose/jmap-core": ["packages/jmap-core/src/index.ts"],
      "@bullmoose/account-do": ["packages/account-do/src/index.ts"],
      "@bullmoose/mailstore": ["packages/mailstore/src/index.ts"],
      "@bullmoose/mime": ["packages/mime/src/index.ts"],
      "@bullmoose/outbound": ["packages/outbound/src/index.ts"],
      "@bullmoose/scheduling": ["packages/scheduling/src/index.ts"],
      // Test-only. Deliberately NOT linked into node_modules: it imports
      // node:sqlite, which workerd does not have, so resolution exists only
      // here and in vitest.config.ts and a worker build fails on the bare
      // specifier rather than bundling it.
      "@bullmoose/test-fakes": ["packages/test-fakes/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts"],
  // Two workspaces are typechecked with their OWN compiler settings, not this
  // workers-typed program, so they're excluded here and chained into the root
  // `typecheck` script (`&& npm run -w webmail typecheck && npm run -w
  // @bullmoose/cli typecheck`):
  //   • packages/cli — a Node program (node:sqlite etc.); Node globals clash
  //     with workers-types.
  //   • webmail (s03.C) — an Astro + Preact browser app; DOM libs + preact JSX
  //     clash with workers-types the same way. Now a REAL directory (it used to
  //     be a stale exclude of a dir that never existed): its `astro build`
  //     validates the .astro files and its tsconfig(.test).json typecheck the
  //     .ts/.tsx. A project reference doesn't fit — it would force composite +
  //     emit on a noEmit Astro app — so the exclude-plus-chain pattern (proven
  //     by cli) is the honest resolution.
  "exclude": ["node_modules", "src", "packages/cli", "webmail"]
}
