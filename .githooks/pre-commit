#!/bin/sh
# bullmoose pre-commit — keep every commit oxfmt-clean and oxlint-clean, so
# formatting never drifts far enough to need a repo-wide reflow again (the
# "oxmft mega-change" that motivated this hook). It mirrors CI exactly
# (.github/workflows/mail-typecheck.yml runs `npm run fmt:check` + `npm run
# lint`), scoped to the files you are actually committing so it stays fast.
#
#   • formats staged JS/TS/JSON in place and re-stages them, so the commit
#     records the formatted bytes — you never push something CI will reject;
#   • lints the JS/TS subset and BLOCKS the commit on a real error.
#
# Bypass in a genuine pinch with `git commit --no-verify`; CI is the backstop.
# Wired by the root `prepare` script (`git config core.hooksPath .githooks`),
# so it activates on `npm install` — no husky, no extra dependency.
set -e

# Staged, added/copied/modified only, and only the extensions oxc handles.
# (Repo convention: no spaces in paths, so word-splitting $staged is safe.)
staged=$(git diff --cached --name-only --diff-filter=ACM -- \
  '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs' '*.jsx' '*.json' '*.jsonc')
[ -z "$staged" ] && exit 0

# Prefer the installed binary (fast, offline); fall back to `npx --yes` for a
# clone whose deps are not installed yet (non-interactive: never prompts).
if [ -x node_modules/.bin/oxfmt ]; then oxfmt="node_modules/.bin/oxfmt"; else oxfmt="npx --yes oxfmt"; fi
if [ -x node_modules/.bin/oxlint ]; then oxlint="node_modules/.bin/oxlint"; else oxlint="npx --yes oxlint"; fi

# Format in place and re-stage, so the commit records the formatted bytes.
#
# oxfmt exits NON-ZERO with "Expected at least one target file" when every
# staged path is one it ignores — e.g. a commit touching only
# services/*/wrangler.jsonc, which .oxfmtrc.json excludes. Under `set -e` that
# aborted the commit outright (hit 2026-08-20 declaring a worker route). An
# empty target set is not a formatting failure; a real one still is, so match
# that one message and let everything else stay fatal.
if ! fmt_out=$($oxfmt --write $staged 2>&1); then
  case "$fmt_out" in
    *"Expected at least one target file"*) : ;;
    *) printf '%s\n' "$fmt_out" >&2; exit 1 ;;
  esac
fi
git add $staged

# Lint only the JS/TS subset — oxlint has nothing to say about JSON. A real
# error exits non-zero and, under `set -e`, aborts the commit.
lintable=$(echo "$staged" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs|jsx)$' || true)
[ -n "$lintable" ] && $oxlint $lintable

exit 0
