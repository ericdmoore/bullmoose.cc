{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bullmoose-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // This worker is the Email Routing target ("catch-all → worker") for
  // every hosted zone; the Provisioning worker wires that per domain.

  // s12 graduation sweep (src/graduationSweep.ts) — the same cron +
  // scheduled() pattern as bullmoose-agent's drain net. Hourly is plenty:
  // graduation is a cost optimization, not a correctness deadline.
  "triggers": { "crons": ["17 * * * *"] },

  // AccountDO is declared by bullmoose-jmap; bind it cross-script.
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_DO", "class_name": "AccountDO", "script_name": "bullmoose-jmap" },
    ],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bullmoose-mail-shard0",
      "database_id": "c30899c2-3cce-439e-a4b0-73e8e83efee9",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "bullmoose-mail-blobs" }],
  "kv_namespaces": [{ "binding": "ROUTES", "id": "27a812f0c1aa48fca2a090eb2a94f52a" }],

  // Cloud agent runtime — poked (fire-and-forget) after invocation inserts.
  "services": [{ "binding": "AGENT", "service": "bullmoose-agent" }],

  // Secrets (wrangler secret put):
  //   INTERNAL_TOKEN — authenticates the agent poke (same shared secret)
  //
  // Optional var (deliberately UNSET, so the code's conservative default is
  // the one place the number lives — see src/sidestep.ts):
  //   ATTACHMENT_SIDESTEP_BYTES — bytes at or above which an inbound
  //     attachment also becomes a FileNode (s03.B T3). Default 5 MiB; "0"
  //     turns the sidestep off; a route's `sidestepBytes` overrides it per
  //     account.
}
