{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bullmoose-jmap",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // SAME-ORIGIN API for app.bullmoose.cc (s07 T1). Pages serves the app's
  // documents; these five patterns hand the API paths to this worker instead.
  // Worker routes take precedence over Pages on a shared hostname, so the two
  // coexist on one name and the browser never makes a cross-origin request.
  //
  // Why same-origin and not api.bullmoose.cc: this worker sends NO CORS headers
  // and has no OPTIONS handler (src/index.ts), so a cross-origin app would fail
  // at preflight before reaching any of these routes. Same-origin removes the
  // CORS surface entirely rather than adding one to get wrong.
  //
  // The list is EXACTLY the paths src/index.ts answers, and a single "/api/*"
  // is not enough -- the client opens with `/.well-known/jmap` (JmapClient.ts:150)
  // and the door posts to `/auth/login`. Anything not listed here falls through
  // to Pages and 404s as HTML, which reads as "the app is broken" rather than
  // "the route is missing". webmail/src/lib/app/sameOrigin.test.ts asserts both
  // directions; keep this in sync with src/index.ts's dispatch.
  "routes": [
    { "pattern": "app.bullmoose.cc/.well-known/jmap", "zone_name": "bullmoose.cc" },
    { "pattern": "app.bullmoose.cc/api/*", "zone_name": "bullmoose.cc" },
    { "pattern": "app.bullmoose.cc/auth/*", "zone_name": "bullmoose.cc" },
    // The agent console's read interface (s03.E, src/console.ts). Same-origin
    // for the same reason as the rest: services/agent — which owns
    // /vault/credentials — has no public route and sends no CORS headers, so a
    // browser cannot read these there. Nothing in webmail/src/pages is named
    // `console`, and sameOrigin.test.ts keeps it that way.
    { "pattern": "app.bullmoose.cc/console/*", "zone_name": "bullmoose.cc" },
    // Share links are public-by-design URLs handed to people with no account.
    // They live here because this worker serves them and the API base is what
    // mints them; giving them their own hostname is a product decision, not a
    // routing one.
    { "pattern": "app.bullmoose.cc/share/*", "zone_name": "bullmoose.cc" }

    // ── s20, the explorer — DELIBERATELY COMMENTED OUT ────────────────────
    //
    // `explore.bullmoose.cc` is a read-only mirror of everything the caller can
    // see. `.plans/s20-explorer` open question 2: a deployment that does not
    // want it must serve NOTHING — "not a flag inside a worker that serves the
    // product" — so the default is no route, no DNS record and no secrets, and
    // the switch is three deliberate acts rather than one.
    //
    // It lives on its own hostname, not a path under app.bullmoose.cc, and
    // that is not aesthetics (open question 1): app.bullmoose.cc keeps a device
    // token in localStorage and renders attacker-authored email HTML, so
    // same-origin would mean a bug in either surface reaches the other's
    // credential. A separate host also makes the cookie host-only by
    // construction, with no Path gymnastics to get wrong.
    //
    // TO TURN IT ON:
    //
    //     node infra/bootstrap.mjs explorer      (add --dry-run to preview)
    //     node infra/bootstrap.mjs deploy
    //
    // and to withdraw it:
    //
    //     node infra/bootstrap.mjs explorer --off
    //     node infra/bootstrap.mjs deploy
    //
    // The four manual steps that used to be written out here are that script's
    // `explorer` phase, one function each and each idempotent — re-running is
    // safe, and every step reports what it skipped:
    //
    //   1. DNS. A PROXIED AAAA for `explore` → 100:: in the bullmoose.cc zone.
    //      (AAAA over a CNAME to app.bullmoose.cc because it fails CLOSED: with
    //      no route, 100:: has no origin to fall through to, where a CNAME
    //      would quietly serve the Pages app on this hostname. Both are equally
    //      fine while the route exists — a proxied record never contacts its
    //      origin.) Nothing resolves without this, so an uncommented route with
    //      no record still serves nothing.
    //   2. This file: uncomment the route below and the OAUTH service binding
    //      further down. The script EDITS THIS FILE rather than creating the
    //      route over the API, because `wrangler deploy` reconciles routes from
    //      config — an API-created route would be silently removed by the next
    //      deploy of this worker. Commit the diff: the switch belongs in git.
    //   3. The OAuth client, registered ONCE (a public client;
    //      `token_endpoint_auth_method: "none"`, PKCE binds the code) and its
    //      id persisted to .env. The script refuses to register again once
    //      EXPLORE_CLIENT_ID is set — a second registration mints an orphan
    //      client nobody can enumerate or revoke. DCR is used exactly here, out
    //      of band and once; see src/explore/oauth.ts for why the request path
    //      uses a pre-registered client instead.
    //   4. The configuration: EXPLORE_COOKIE_KEY (generated, 32 bytes, and
    //      never re-minted over a live one without --rotate — that would sign
    //      out every session), EXPLORE_HOST, EXPLORE_CLIENT_ID, and
    //      EXPLORE_CLIENT_SECRET only if step 3's AS returned one.
    //      Only the first is actually a secret. The others go through
    //      `secret put` for a different reason: a `vars` entry would be
    //      COMMITTED, and committing the master switch is the same as turning
    //      the explorer on for every deployment of this repo. EXPLORE_HOST is
    //      that switch — with it unset the worker reads no cookie anywhere and
    //      none of src/explore/ is reachable, whatever the route says.
    //
    // No migration is needed and none should be added: the cookie is a
    // stateless HMAC, PKCE state lives in the existing ROUTES KV, and the
    // projection reads DB through the JMAP method registry. No new tables, no
    // new resources. `node infra/bootstrap.mjs doctor` checks the result —
    // and reports "explorer: off" without complaint when EXPLORE_HOST is unset.
    //
    // , { "pattern": "explore.bullmoose.cc/*", "zone_name": "bullmoose.cc" }
  ],

  // AccountDO lives in THIS worker; ingest/submit bind it via script_name.
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_DO", "class_name": "AccountDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountDO"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bullmoose-mail-shard0",
      "database_id": "c30899c2-3cce-439e-a4b0-73e8e83efee9"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "bullmoose-mail-blobs" }],
  // ROUTES is the shared small-hot-state namespace. This worker also keeps the
  // /auth/login throttle windows here under `login:` keys (see loginThrottle.ts) —
  // deliberately NOT a second namespace: `infra/bootstrap.mjs` wire rewrites only
  // the first "id" after "kv_namespaces", so a second one would be clobbered.
  "kv_namespaces": [{ "binding": "ROUTES", "id": "27a812f0c1aa48fca2a090eb2a94f52a" }],

  // Outbound sends go through the submit worker (which holds SES creds).
  //
  // The second entry is s20's, and is commented out with the explore route
  // above — the two are turned on together. The explorer redeems an
  // authorization code and asks who a token belongs to; OAUTH_KV is bound to
  // services/oauth and nowhere else, so both are hops across this binding
  // (services/agent's OAUTH binding has the same shape for the same reason).
  // Leaving it out by default also keeps this worker's deploy graph unchanged
  // for anyone not running an explorer.
  "services": [
    { "binding": "SUBMIT", "service": "bullmoose-submit" }
    // , { "binding": "OAUTH", "service": "bullmoose-oauth" }
  ],

  "vars": {
    // Dev-only single-account auth. The real front door is the OAuth 2.1
    // authorization server in `services/oauth` (worker `bullmoose-oauth`),
    // served at auth.bullmoose.cc — note the hostname and the directory differ,
    // so grepping for "services/auth" finds nothing. Not OIDC: it is an
    // OAuth 2.1 AS (services/oauth/src/index.ts:11).
    "DEV_ACCOUNT_ID": "t_dev__a_local",
    "DEV_TENANT_ID": "t_dev",
    "DEV_USERNAME": "dev@localhost"
  }
  // Secrets (wrangler secret put):
  //   DEV_BEARER_TOKEN
  //   INTERNAL_TOKEN     — must match the submit worker's INTERNAL_TOKEN
  //   SHARE_SIGNING_KEY  — HMAC key for expiring /share/* links
}
